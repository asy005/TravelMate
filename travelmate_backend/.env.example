POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=travelmate_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Generate a strong random value for production, e.g.: openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_ENV=
GROQ_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
OPENTRIPMAP_API_KEY=
OPENWEATHER_API_KEY=

LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# OCR — Tesseract binary path (set per machine; leave blank to use system PATH)
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac example: TESSERACT_CMD=/usr/bin/tesseract
# If Tesseract is on PATH and accessible, this can be left empty.
TESSERACT_CMD=
TESSDATA_PREFIX=

# Phase 7: Currency Conversion (optional API key, uses open endpoint when blank)
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_TTL_SECONDS=3600

# Optional: Google Cloud Vision DOCUMENT_TEXT_DETECTION for high-accuracy OCR (Kannada + English)
# If provided, Google Cloud Vision is used as primary OCR provider; falls back to local Tesseract if empty or on error.
GOOGLE_VISION_API_KEY=
